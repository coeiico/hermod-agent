{
  "name": "hermod-agent",
  "description": "Hermod Agent: plain-language browser commands for Chromium browsers, powered by Claude",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coeiico/hermod-agent.git"
  },
  "type": "module",
  "scripts": {
    "brand:icons": "bash scripts/generate-icons.sh",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "wxt build && node e2e/run.mjs",
    "screenshots": "wxt build && node e2e/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
